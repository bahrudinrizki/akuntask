# Application
NODE_ENV=development
APP_PORT=3000
APP_NAME=Akuntask

# Frontend
WEB_PORT=5173
VITE_API_URL=http://localhost:3000

# Database (Phase 0.5: SQLite for dev, switch to Postgres for prod)
# Dev (SQLite - zero install)
DATABASE_URL="file:./prisma/dev.db"
# Prod (PostgreSQL 15)
# DATABASE_URL="postgresql://akuntask:CHANGE_ME@localhost:5432/akuntask?schema=public"

# Auth
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_64_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# Cache (Phase 4+)
# REDIS_URL=redis://localhost:6379
