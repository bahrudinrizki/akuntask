{
  "name": "akuntask",
  "version": "0.1.0",
  "private": true,
  "description": "Aplikasi Akuntansi & Manajemen Bisnis Online (PRD v1.0)",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @akuntask/api run db:generate",
    "db:migrate": "pnpm --filter @akuntask/api run db:migrate",
    "db:seed": "pnpm --filter @akuntask/api run db:seed"
  },
  "devDependencies": {
    "typescript": "5.5.4",
    "prettier": "3.3.3",
    "eslint": "9.9.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
