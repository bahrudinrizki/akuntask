{
  "name": "@akuntask/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build --tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../../.env -- ts-node prisma/seed.ts",
    "test:e2e": "node test/e2e/full-flow.mjs",
    "prisma": "dotenv -e ../../.env -- prisma"
  },
  "dependencies": {
    "@nestjs/common": "10.4.4",
    "@nestjs/core": "10.4.4",
    "@nestjs/platform-express": "10.4.4",
    "@nestjs/config": "3.2.3",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@prisma/client": "5.20.0",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "@akuntask/shared": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/schematics": "10.1.4",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "4.17.21",
    "@types/node": "22.5.5",
    "@types/passport-jwt": "4.0.1",
    "dotenv-cli": "7.4.2",
    "prisma": "5.20.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.5.4"
  }
}
