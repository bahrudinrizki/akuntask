// Prisma schema — multi-tenant accounting platform
// Phase 0.5: SQLite for zero-install dev, swap provider to postgresql for prod

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  npwp      String?  @unique
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users      User[]
  coa        ChartOfAccount[]
  journals   Journal[]

  @@map("companies")
}

// COA types per PSAK: ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
// Multi-level: level 1 (header), level 2 (sub-header), level 3+ (detail)
model ChartOfAccount {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  code      String
  name      String
  type      String
  parentId  String?  @map("parent_id")
  level     Int      @default(1)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent       ChartOfAccount?   @relation("CoaTree", fields: [parentId], references: [id])
  children     ChartOfAccount[]  @relation("CoaTree")
  journalLines JournalLine[]

  @@unique([companyId, code])
  @@index([companyId, type])
  @@index([parentId])
  @@map("chart_of_accounts")
}

model Journal {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  referenceNo String   @map("reference_no")
  date        DateTime
  description String
  status      String   @default("POSTED")
  totalDebit  Float    @map("total_debit")
  totalCredit Float    @map("total_credit")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("JournalCreator", fields: [createdById], references: [id])
  lines     JournalLine[]

  @@unique([companyId, referenceNo])
  @@index([companyId, date])
  @@map("journals")
}

model JournalLine {
  id          String  @id @default(cuid())
  journalId   String  @map("journal_id")
  coaId       String  @map("coa_id")
  debit       Float   @default(0)
  credit      Float   @default(0)
  description String?

  journal Journal        @relation(fields: [journalId], references: [id], onDelete: Cascade)
  coa     ChartOfAccount @relation(fields: [coaId], references: [id])

  @@index([journalId])
  @@index([coaId])
  @@map("journal_lines")
}

model User {
  id           String    @id @default(cuid())
  companyId    String    @map("company_id")
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roles      UserRole[]
  journals   Journal[]  @relation("JournalCreator")

  @@index([companyId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  // Permissions stored as JSON-encoded string for SQLite compat
  // PRD §9.1 RBAC: role perms map to ACC/SAL/PUR/INV/POS/RPT/AI/INT modules
  permissions String   @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  companyId  String?  @map("company_id")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  oldValues  String?  @map("old_values")
  newValues  String?  @map("new_values")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}
